git_url("git@github.com:RISCfuture/certificates.git")
storage_mode("git")

# The certificates repository keeps every app's certificates and profiles on `main`, and it is not
# the branch match reaches for: its git_branch defaults to "master". A branch that does not exist is
# not an error to match — it starts an empty one — and a `master` that another match run pushed
# holds only that run's profiles, so a read-only sync fails to find this app's.
git_branch("main")

type("developer_id")
team_id("2NFSK2WB24")

# The app is sandboxed and carries a keychain access group, which a bare Developer ID signature
# cannot satisfy, so a `developer_id` profile is synced for it rather than only a certificate. The
# archive still signs automatically, so the project stays on automatic signing for local
# development; only the export consumes this profile, which the Fastfile names in its export
# options from match's mapping.
app_identifier("codes.tim.LogTenAssistant")
